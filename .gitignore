# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.env
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data, checkpoints, logs, and explorer cache (keep directory skeletons via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/explorer/*
!data/explorer/.gitkeep
models/*
!models/.gitkeep
logs/*
!logs/.gitkeep
explorer/cache/*
!explorer/cache/.gitkeep
explorer/dist/
*.pkl
*.npz
*.ckpt
*.zip
*.log

# Intermediate per-GPU ablation outputs
ablation/ablation_results_gpu*.csv
ablation/ablation_results_gpu*.json
ablation/ablation_results_retry_*.csv
ablation/ablation_results_retry_*.json
